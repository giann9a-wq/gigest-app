# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gigest?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"
AUTH_TRUST_HOST=true

# Optional base URL for local callbacks
AUTH_URL="http://localhost:3000"

# Optional explicit Google Calendar OAuth callback.
# Add this exact URI in Google Cloud Console > OAuth client > Authorized redirect URIs.
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:3000/api/google-calendar/callback"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="replace-with-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="replace-with-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="GiGest Documentale"

# Google Drive documentale
GOOGLE_DRIVE_CLIENT_ID="replace-with-google-drive-client-id"
GOOGLE_DRIVE_CLIENT_SECRET="replace-with-google-drive-client-secret"
GOOGLE_DRIVE_REDIRECT_URI="http://localhost:3000/api/google-drive/callback"
GOOGLE_DRIVE_SETUP_KEY="replace-with-temporary-random-setup-key"
GOOGLE_DRIVE_REFRESH_TOKEN="replace-with-google-drive-refresh-token"
GOOGLE_DRIVE_ROOT_FOLDER_NAME="GiGEST Documentale"
GMAIL_SCANS_SYNC_SECRET="replace-with-random-cron-secret"
DIARY_REMINDER_SECRET="replace-with-random-cron-secret"

# Note: il refresh token documentale deve includere almeno questi scope:
# - https://www.googleapis.com/auth/drive
# - https://www.googleapis.com/auth/gmail.readonly
# - https://www.googleapis.com/auth/gmail.send

# Seed produzione
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_FIRST_NAME="Admin"
SEED_ADMIN_LAST_NAME="GiGEST"
SEED_ADMIN_PANEL_PASSWORD="change-this-admin-panel-password"
SEED_DEMO_DATA=false
